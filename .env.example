# Copy to .env.local and add your own credentials. Never commit that file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Private buyer-only channel for recommendations and approvals.
SLACK_APPROVAL_CHANNEL=
# Dedicated demo supplier channel; never use the approval channel here.
SLACK_SUPPLIER_CHANNEL=
# Comma-separated Slack user IDs, not names. Use two accounts to test routing.
SLACK_CFO_USERS=
SLACK_PROCUREMENT_USERS=
# Only these users may act as the fictional supplier.
SLACK_SUPPLIER_USERS=
# Slack workspace/team ID (T...). Limits callbacks to the configured workspace.
SLACK_TEAM_ID=
# Session response deadline, including sandbox provisioning.
AGENT_TIMEOUT_MS=120000
DEALGUARD_STATE_PATH=.dealguard/live.json

# MentorOS live research and voice. Leave blank for explicit rehearsal only.
EXA_API_KEY=
MENTOR_MODEL=gpt-6-astra
MENTOR_STATE_PATH=.mentor/state.json
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Optional override; blank uses each provider's bounded default.
PROVIDER_TIMEOUT_MS=
PORT=3210

# Custom mentor ecosystem and image tools.
MENTOR_BUILDER_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
# One high-quality 1024px PNG per image request. No fallback to an older model.
OPENAI_IMAGE_MODEL=gpt-image-2
# Blank council overrides inherit the Agents model above.
COUNCIL_MODEL=
COUNCIL_SYNTHESIS_MODEL=
