{
  "display_information": {
    "name": "DealGuard",
    "description": "Evidence-backed counteroffers, with the right approval.",
    "background_color": "#153d35"
  },
  "features": { "bot_user": { "display_name": "DealGuard", "always_online": false } },
  "oauth_config": { "scopes": { "bot": ["chat:write", "channels:read", "channels:history", "groups:read", "groups:history"] } },
  "settings": {
    "event_subscriptions": { "bot_events": ["message.channels", "message.groups"] },
    "interactivity": { "is_enabled": true },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
